# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude Code tooling
# .claude/commands/ is checked in deliberately: the workflow has to travel with
# the repo so every contributor's Claude session runs the same one, whatever is
# installed on their own machine.
.claude/*
!.claude/commands/
.claude/settings.local.json

# iOS / Swift Package Manager build state
ios/App/CapApp-SPM/.build/
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Python bytecode from scripts/
__pycache__/
